{
  "version": 1,
  "scan": {
    "roots": ["domains/wire/include", "domains/wire/src", "domains/wire/tests", "domains/wire/tools", "domains/road/include", "domains/road/src", "domains/road/tests", "viewer/src", "viewer/tests", "web/src", "web/tests", "web/wasm", "tools"],
    "extensions": [".cpp", ".hpp", ".py", ".ts", ".svelte"],
    "exclude_patterns": [
      "web/wasm/build/**",
      "web/wasm/build/**/*",
      "web/wasm/build-*/**",
      "web/wasm/build-*/*",
      "web/wasm/build-asan/**",
      "web/wasm/build-asan/**/*",
      "web/wasm/build-nmake/**",
      "web/wasm/build-nmake/**/*",
      "web/src/wasm-generated/**",
      "web/src/wasm-generated/**/*"
    ]
  },
  "layers": [
    {
      "name": "public_api",
      "patterns": ["domains/wire/include/city/wire/*.hpp", "domains/wire/include/city/wire/support/*.hpp"],
      "forbidden_tokens": ["domains/wire/src/"]
    },
    {
      "name": "state_internal",
      "patterns": [
        "domains/wire/src/state/*.cpp",
        "domains/wire/src/state/*.hpp",
        "domains/wire/src/state/**/*.cpp",
        "domains/wire/src/state/**/*.hpp"
      ],
      "forbidden_tokens": ["viewer/"]
    },
    {
      "name": "generation_backbone",
      "patterns": ["domains/wire/src/generation/backbone/*.cpp", "domains/wire/src/generation/backbone/*.hpp"],
      "forbidden_tokens": ["viewer/", "ProcessDirtyQueues", "support_layout_contract", "support_layout_projection"]
    },
    {
      "name": "generation_input",
      "patterns": [
        "domains/wire/src/generation/*.cpp",
        "domains/wire/src/generation/*.hpp",
        "domains/wire/src/generation/pole_facing/*.cpp",
        "domains/wire/src/generation/pole_facing/*.hpp"
      ],
      "forbidden_tokens": ["viewer/", "generation/backbone/pipeline.hpp"]
    },
    {
      "name": "derive_or_output",
      "patterns": [],
      "forbidden_tokens": []
    },
    {
      "name": "geometry",
      "patterns": [
        "domains/wire/src/geometry/*.cpp",
        "domains/wire/src/geometry/*.hpp",
        "domains/wire/src/geometry/**/*.cpp",
        "domains/wire/src/geometry/**/*.hpp"
      ],
      "forbidden_tokens": ["generation/backbone/", "viewer/"]
    },
    {
      "name": "validation",
      "patterns": ["domains/wire/src/validation/*.cpp", "domains/wire/src/validation/*.hpp"],
      "forbidden_tokens": ["AddPole(", "AddPort(", "AddSpan(", "cache_span_", "generation/backbone/"]
    },
    {
      "name": "core_internal",
      "patterns": ["domains/wire/src/pch.hpp", "domains/wire/src/collection_utils.hpp", "domains/wire/src/support/*.hpp", "domains/wire/src/support/*.cpp"],
      "forbidden_tokens": ["viewer/"]
    },
    {
      "name": "road_domain",
      "patterns": [
        "domains/road/include/city/road/*.hpp",
        "domains/road/include/city/road/**/*.hpp",
        "domains/road/src/*.cpp",
        "domains/road/src/*.hpp",
        "domains/road/src/**/*.cpp",
        "domains/road/src/**/*.hpp"
      ],
      "forbidden_tokens": ["city/wire", "domains/wire"]
    },
    {
      "name": "viewer",
      "patterns": ["viewer/src/*.cpp", "viewer/src/*.hpp"],
      "forbidden_tokens": ["domains/wire/src/"]
    },
    {
      "name": "tests",
      "patterns": [
        "domains/wire/tests/*.cpp",
        "domains/wire/tests/*.hpp",
        "domains/wire/tests/**/*.cpp",
        "domains/wire/tests/**/*.hpp",
        "domains/road/tests/*.cpp",
        "domains/road/tests/*.hpp",
        "domains/road/tests/**/*.cpp",
        "domains/road/tests/**/*.hpp",
        "viewer/tests/*.cpp",
        "viewer/tests/*.hpp"
      ],
      "forbidden_tokens": []
    },
    {
      "name": "web_binding",
      "patterns": ["web/wasm/*.cpp"],
      "forbidden_tokens": ["domains/wire/src/", "viewer/"]
    },
    {
      "name": "web_model",
      "patterns": ["web/src/model.ts", "web/src/road.ts", "web/src/road_templates.ts"],
      "forbidden_tokens": ["./bridge/", "./actions/", "./render/", "city/wire", "viewer/"]
    },
    {
      "name": "web_bridge",
      "patterns": ["web/src/bridge/*.ts"],
      "forbidden_tokens": ["viewer/", "domains/wire/src/"]
    },
    {
      "name": "web_build",
      "patterns": ["web/src/buildInfo.ts"],
      "forbidden_tokens": ["viewer/", "domains/wire/src/", "city/wire"]
    },
    {
      "name": "web_console",
      "patterns": ["web/src/consoleLog.ts"],
      "forbidden_tokens": ["./bridge/", "./actions/", "./render/", "city/wire", "viewer/"]
    },
    {
      "name": "web_store",
      "patterns": ["web/src/store/*.ts"],
      "forbidden_tokens": ["../actions/", "../render/", "viewer/"]
    },
    {
      "name": "web_actions",
      "patterns": ["web/src/actions/*.ts"],
      "forbidden_tokens": ["../render/", "viewer/"]
    },
    {
      "name": "web_profile",
      "patterns": ["web/src/profile/*.ts"],
      "forbidden_tokens": ["../bridge/", "../actions/", "../render/", "city/wire", "viewer/"]
    },
    {
      "name": "web_render",
      "patterns": ["web/src/render/*.ts"],
      "forbidden_tokens": ["../bridge/", "../actions/", "city/wire", "viewer/"]
    },
    {
      "name": "web_panels",
      "patterns": ["web/src/*.svelte", "web/src/panels/*.svelte", "web/src/labels.ts"],
      "forbidden_tokens": ["/bridge/", "city/wire", "viewer/"]
    },
    {
      "name": "web_entry",
      "patterns": ["web/src/main.ts", "web/src/vite-env.d.ts"],
      "forbidden_tokens": ["city/wire", "viewer/"]
    },
    {
      "name": "web_tests",
      "patterns": ["web/tests/*.ts"],
      "forbidden_tokens": []
    },
    {
      "name": "tools",
      "patterns": ["domains/wire/tools/*.cpp", "tools/*.py"],
      "forbidden_tokens": []
    }
  ],
  "guards": {
    "forbidden_symbols": [
      "ProcessDirtyQueues",
      "Commit(run_recalc",
      "support_authority",
      "seed_projection",
      "projection_materialization",
      "support_layout_contract",
      "support_layout_projection",
      "cache_span_support_layout",
      "generate_grouped_spans_between_support_nodes",
      "span-derived backbone"
    ],
    "forbidden_core_domain_symbols": [
      "RoadId",
      "RoadSegment",
      "RoadEdgeId",
      "RailwayTrackId",
      "BuildingId",
      "kBuilding",
      "TerrainTileId",
      "LaneId",
      "SidewalkWidth",
      "TrackGauge",
      "FacadeId"
    ]
  }
}
