{
  "name": "wire-web-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm:configure": "scripts\\wasm-nmake-build.cmd configure",
    "wasm:build": "npm run wasm:configure && scripts\\wasm-nmake-build.cmd build",
    "test": "npm run wasm:build && vitest run",
    "build": "npm run wasm:build && vite build",
    "dev": "vite",
    "check": "tsc --noEmit",
    "deploy": "npm run build && wait-on dist/index.html && gh-pages -d dist"
  },
  "dependencies": {
    "svelte": "^5.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/three": "^0.180.0",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.10.6",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wait-on": "^9.0.10"
  }
}
