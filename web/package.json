{
  "name": "wire-web-viewer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "assets:wire-patterns": "node scripts/generate-wire-pattern-assets.mjs",
    "wasm:configure": "scripts\\wasm-nmake-build.cmd configure",
    "wasm:build": "scripts\\wasm-nmake-build.cmd build",
    "test": "vitest run",
    "test:with-wasm": "npm run wasm:build && vitest run",
    "build": "npm run wasm:build && vite build",
    "dev": "node scripts/ensure-wasm.mjs && vite",
    "check": "tsc --noEmit",
    "deploy": "npm run build && wait-on dist/index.html && gh-pages -d dist --no-history"
  },
  "dependencies": {
    "@lucide/svelte": "^1.27.0",
    "svelte": "^5.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/three": "^0.180.0",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.10.6",
    "typescript": "^5.9.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.0",
    "wait-on": "^9.0.10"
  }
}
