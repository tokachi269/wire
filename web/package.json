{
  "name": "wire-web-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm:configure": "emcmake cmake -S wasm -B wasm/build -G Ninja -DBUILD_TESTING=OFF -DWIRE_ENABLE_PCH=OFF",
    "wasm:build": "npm run wasm:configure && cmake --build wasm/build --target wire_web_core -j 8",
    "test": "npm run wasm:build && vitest run",
    "build": "npm run wasm:build && tsc --noEmit"
  },
  "dependencies": {
    "svelte": "^5.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
